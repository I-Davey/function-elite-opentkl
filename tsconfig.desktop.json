{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "packages",
    "outDir": ".build/desktop",
    "declaration": true,
    "noEmitOnError": true,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "include": ["packages/desktop/src/**/*.cts", "packages/contracts/desktop*.cts"]
}
