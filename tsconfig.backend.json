{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "packages/backend/src",
    "outDir": "dist/backend",
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["packages/backend/src/**/*.cts"],
  "references": [{ "path": "./tsconfig.json" }]
}
