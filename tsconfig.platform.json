{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "rootDir": "packages/ui-platform/src",
    "outDir": "dist/platform",
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["packages/ui-platform/src/*.cts"]
}
