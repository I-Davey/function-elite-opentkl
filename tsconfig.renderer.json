{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "packages/renderer/src/**/*.ts",
    "packages/renderer/src/**/*.tsx",
    "packages/keyboard-ui/src/**/*.ts",
    "packages/keyboard-ui/src/**/*.tsx"
  ]
}
